    {
      "kind": "confluence",
      "ref": "https://dahl-it.atlassian.net/wiki/spaces/DSPDOC/pages/22776628",
      "revision": "version:8",
      "confidence": "confirmed",
      "note": "Before-price design: daily lowest-price snapshot via timer→queue; schedule 07:00/13:00/19:00; campaign before-price after each snapshot; purge >6 months via separate timer; Outlet hardcoded campaign id; API returns before price in campaign price part. Design intent matching timer→queue handlers — not a binding of exact cron expressions beyond this page."
    },
    {
      "kind": "confluence",
      "ref": "https://dahl-it.atlassian.net/wiki/spaces/DSPDOC/pages/22777574",
      "revision": "version:6",
      "confidence": "confirmed",
      "note": "Product/design intent: DSP Price subscribes to M3 key tables and provides price simulation outside M3 (avoids OIS320MI cost/limits); for ecommerce + customer price list tools. Campaign special case CMNO→CSYTAB. Not deployment proof."
    }
  ],
