    {
      "kind": "confluence",
      "ref": "https://dahl-it.atlassian.net/wiki/spaces/DSPDOC/pages/22777574",
      "revision": "version:6",
      "confidence": "confirmed",
      "note": "Product/design intent: DSP Price subscribes to M3 key tables and provides price simulation outside M3 (avoids OIS320MI cost/limits); for ecommerce + customer price list tools. Campaign special case CMNO\u2192CSYTAB. Not deployment proof."
    },
    {
      "kind": "confluence",
      "ref": "https://dahl-it.atlassian.net/wiki/spaces/DSPDOC/pages/22774388",
      "revision": "version:2",
      "confidence": "confirmed",
      "note": "Historical 2021 API/APIM/Okta naming context (web-870-*). Uncertain whether current env names match; not proof of current topology."
    }
  ],
  "uncertainties": [
    "dsp-price copy has no .git; evidence identified by per-file sha256 (Team Lead ruled HEAD check unnecessary).",
    "AdminController injects IIngressQueueClient (line 18) but the reviewed action only uses the price queue; no ingress edge drawn.",
    "V3 PricesController also uses customer, currency, unit and cost-price readers; grouped under price reading."
  ],
