{
  "name": "dsp-dev-overview-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cd web && npm ci --include=dev && VITE_API_BASE=/api npm run build",
    "start": "node server/index.js",
    "sync-ui": "rm -rf web/src && cp -r ../dev-overview/ui/app/src web/src",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "openid-client": "^5.7.1"
  }
}
